<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo artístico dos Agentes da EEX -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_pattern"
        android:scaleType="centerCrop"
        android:contentDescription="Fundo EEX" />

    <!-- Camada de contraste e borda neo-brutalista -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/eex_widget_card_overlay" />

    <!-- Conteúdo em primeiro plano -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Mascote Dinâmico: Midnight ou Brave -->
        <ImageView
            android:id="@+id/widget_mascot_img"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/widget_agent_midnight"
            android:scaleType="fitCenter"
            android:contentDescription="Agente EEX" />

        <!-- Coluna de Informações -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Linha da Chama de Streak (fireon/fireoff) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:id="@+id/widget_fire_icon"
                    android:layout_width="22dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_fire_off"
                    android:scaleType="fitCenter"
                    android:contentDescription="Status da Chama" />

                <TextView
                    android:id="@+id/widget_streak_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 DIAS"
                    android:textColor="#ffeb3b"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/darumadrop_one" />
            </LinearLayout>

            <!-- Título do Status -->
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROTA PENDENTE!"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/darumadrop_one"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Subtítulo / Diálogo dos Agentes -->
            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Midnight em pânico! Complete todos os hábitos hoje!"
                android:textColor="#f5d0fe"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
