<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <!-- Card Neo-Brutalista Faixa Horizontal -->
    <FrameLayout
        android:id="@+id/widget_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/eex_widget_card_pending">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Mascote -->
            <ImageView
                android:id="@+id/widget_mascot_img"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/widget_agent_midnight"
                android:scaleType="fitCenter"
                android:contentDescription="Mascote EEX" />

            <!-- Pill de Fogo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eex_widget_badge_streak"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:paddingTop="1dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/widget_fire_icon"
                    android:layout_width="14dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/widget_fire_off"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chama" />

                <TextView
                    android:id="@+id/widget_streak_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 DIAS"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/darumadrop_one" />
            </LinearLayout>

            <!-- ViewFlipper com Texto no Centro -->
            <ViewFlipper
                android:id="@+id/widget_view_flipper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoStart="true"
                android:flipInterval="3500">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ROTA PENDENTE!"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/darumadrop_one"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_progress_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏳ HÁBITOS PENDENTES"
                    android:textColor="#ffeb3b"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/darumadrop_one"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_shells_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🐚 EXPEDIENTE EEX"
                    android:textColor="#00f0ff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/darumadrop_one"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </ViewFlipper>

            <!-- Botão de Ação -->
            <TextView
                android:id="@+id/widget_btn_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eex_widget_btn_action"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="8dp"
                android:text="⚡ ABRIR"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/darumadrop_one" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
