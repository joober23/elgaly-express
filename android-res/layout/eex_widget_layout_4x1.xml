<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo artístico dos Agentes da EEX -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_pattern"
        android:scaleType="centerCrop"
        android:contentDescription="Fundo EEX" />

    <!-- Camada de contraste e borda neo-brutalista -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/eex_widget_card_overlay" />

    <!-- Conteúdo Faixa 4x1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Mascote Dinâmico: Midnight ou Brave -->
        <ImageView
            android:id="@+id/widget_mascot_img"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_agent_midnight"
            android:scaleType="fitCenter"
            android:contentDescription="Agente EEX" />

        <!-- Chama de Streak -->
        <ImageView
            android:id="@+id/widget_fire_icon"
            android:layout_width="20dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_fire_off"
            android:scaleType="fitCenter"
            android:contentDescription="Chama" />

        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="0 DIAS"
            android:textColor="#ffeb3b"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/darumadrop_one" />

        <!-- Título do Status na Faixa -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ROTA PENDENTE!"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/darumadrop_one"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- TextView invisível para compatibilidade de ID -->
        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
