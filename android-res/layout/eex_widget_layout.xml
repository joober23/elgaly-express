<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/eex_widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Mascote: Agente Midnight (quando pendente) ou Agente Brave (quando concluído) -->
    <ImageView
        android:id="@+id/widget_mascot_img"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:src="@drawable/widget_agent_midnight"
        android:contentDescription="Agente EEX"
        android:scaleType="fitCenter" />

    <!-- Textos e Status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Badge de Sequência / Streak -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_streak_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eex_widget_badge_bg"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:text="🔥 0 DIAS"
                android:textColor="#1a0826"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Título do Status -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROTA PENDENTE!"
            android:textColor="#ffeb3b"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Frase de Humor / Chamado do Mascote -->
        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Midnight está em pânico! Complete a rotina de hoje!"
            android:textColor="#f5d0fe"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
